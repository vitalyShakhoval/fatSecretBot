# Required Telegram settings
TELEGRAM_BOT_TOKEN=replace_with_bot_token
TELEGRAM_USER_ID=123456789
TELEGRAM_CHAT_ID=123456789

# IANA timezone (zoneinfo), not a fixed UTC offset
TIMEZONE=Europe/Moscow
REPORT_HOUR=12
REPORT_MINUTE=0

# Local state: goals, schedule settings, identifiers, sync state and <=24h cache
DATABASE_PATH=health_bot.sqlite3
CACHE_TTL_SECONDS=3600

# Garmin credentials are configured only here, never through Telegram
EMAIL=you@example.com
PASSWORD=replace_locally
GARMINTOKENS=~/.garminconnect

# FatSecret OAuth 1.0a credentials; keep real values only in .env
FATSECRET_CONSUMER_KEY=replace_locally
FATSECRET_CONSUMER_SECRET=replace_locally
FATSECRET_OAUTH_TOKEN=replace_locally
FATSECRET_OAUTH_TOKEN_SECRET=replace_locally
